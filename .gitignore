# =========================================================================
# Unity Generated Folders & Files
# =========================================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# =========================================================================
# Asset Store & Packages
# =========================================================================
# Asset store tokens / download cache
/[Aa]ssets/AssetStoreTools*

# Ignore package tarballs; the manifest.json & packages-lock.json keep track of these
/[Pp]ackages/*
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json

# =========================================================================
# IDE and OS Specific Files
# =========================================================================
# Visual Studio / VS Code
.vs/
.vscode/
/*.csproj
/*.unityproj
/*.sln
/*.suo
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.mdb
/*.opendb
/*.VC.db

# JetBrains Rider
.idea/
[Aa]ssets/Plugins/Editor/JetBrains*

# OS specific
.DS_Store
Thumbs.db

# =========================================================================
# Source Control Safeguards
# =========================================================================
# NEVER ignore .meta files; Unity uses them to map asset IDs
!/[Aa]ssets/**/*.meta

# Crash reports and local builds
sysinfo.txt
*.apk
*.unitypackage
crashlytics-build.properties

